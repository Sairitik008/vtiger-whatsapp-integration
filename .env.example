VTIGER_HTTP_PORT=8080
VTIGER_DB_NAME=vtiger
VTIGER_DB_USER=vtiger
VTIGER_DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Keep mock transport selected until the official Meta setup and security review are complete.
WHATSAPP_TRANSPORT=mock
WHATSAPP_LIVE_SEND_ENABLED=0
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SYSTEM_USER_ID=
# Prefer *_FILE secret mounts in production rather than storing these values in .env.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ACCESS_TOKEN_FILE=
WHATSAPP_APP_SECRET=
WHATSAPP_APP_SECRET_FILE=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN_FILE=
